    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const bin = $input.item.binary || {};\nconst keys = Object.keys(bin);\nlet attachmentType = 'none';\nlet attachmentMime = '';\nlet attachmentName = '';\nlet attachmentKey = '';\nif (keys.length > 0) {\n  attachmentKey = keys[0];\n  const meta = bin[attachmentKey] || {};\n  attachmentMime = meta.mimeType || '';\n  attachmentName = meta.fileName || '';\n  const lowerName = attachmentName.toLowerCase();\n  if (attachmentMime.indexOf('image/') === 0) {\n    attachmentType = 'image';\n  } else if (attachmentMime === 'application/pdf' || lowerName.endsWith('.pdf')) {\n    attachmentType = 'pdf';\n  } else {\n    attachmentType = 'other';\n  }\n}\n$input.item.json.attachmentType = attachmentType;\n$input.item.json.attachmentMime = attachmentMime;\n$input.item.json.attachmentName = attachmentName;\n$input.item.json.attachmentKey = attachmentKey;\n$input.item.json.attachmentCount = keys.length;\nreturn $input.item;"
      },
